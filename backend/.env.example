# Copy to .env.local and fill in these five.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Gemini: Orbit's voice, and how it reads screenshots.
GOOGLE_API_KEY=
# Mem0: what Orbit remembers from one session to the next.
MEM0_API_KEY=

# Everything below is optional. Leave a line commented out to keep the default it shows.

# Where Redis is. Redis itself must be running: it keeps what was said until Orbit's tab closes.
# REDIS_URL=redis://localhost:6379/0

# Ollama reads waiting mail and suggests replies. Leave these unset, so Orbit uses the Ollama
# app on this computer, signed in (`ollama signin`), with gpt-oss:120b-cloud.
# OLLAMA_API_KEY=
# OLLAMA_HOST=http://localhost:11434
# ORBIT_DRAFT_MODEL=gpt-oss:120b-cloud

# Instead of saving Google's client JSON to .secrets/google-oauth-client.json:
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_CLIENT_FILE=

# How long a silence, in seconds, before Orbit answers.
# ORBIT_SILENCE_SECONDS=1.5
# The model that reads screenshots.
# ORBIT_VISION_MODEL=gemini-3.5-flash
# Set to auto to let web search fall back to other engines when DuckDuckGo refuses.
# ORBIT_SEARCH_BACKEND=duckduckgo
# The origins the API accepts, comma-separated, when the app is served from elsewhere.
# ORBIT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where Orbit keeps its data and Google tokens. Point these at scratch folders for experiments.
# ORBIT_DATA_DIR=
# ORBIT_SECRETS_DIR=
# Chrome's data folder, if Chrome keeps it somewhere other than the standard place.
# ORBIT_CHROME_USER_DATA=
# Set to 1 to go through drafts and approvals without sending or creating anything.
# ORBIT_DRY_RUN=1
