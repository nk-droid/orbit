# Where the Orbit backend API lives. Leave empty in development: Vite proxies /api
# to http://127.0.0.1:8000 (see vite.config.ts). Set it when the app is hosted
# separately from the API, for example https://api.example.com
VITE_API_BASE_URL=

# In standby the app listens for "Orbit" and starts a conversation when it hears it. The
# listening is done by the browser on this device. Set to off to keep the microphone
# closed until the orb is pressed.
VITE_WAKE_WORD=
